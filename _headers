# Solo lo lee Cloudflare Pages, o sea el sitio de prueba y las vistas previas. En producción no se publica.
# noindex: que no aparezca en Google. CSP: sin Analytics y sin escribir en el buzón ni en el arcade reales.
/*
  X-Robots-Tag: noindex
  Content-Security-Policy: connect-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'

# Archivos de Pagefind con hash del contenido en el nombre: no cambian nunca. Sin hash (no tocar): pagefind.js, pagefind-entry.json, wasm.
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/filter/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/pagefind.*.pf_meta
  Cache-Control: public, max-age=31536000, immutable
